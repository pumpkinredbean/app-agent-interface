{
  "name": "@pumpkinredbean/app-agent-client",
  "version": "0.1.0",
  "description": "Typed TypeScript client for the App Agent Interface protocol",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "sideEffects": false,
  "files": [
    "dist/src",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pumpkinredbean/app-agent-interface.git",
    "directory": "packages/app-agent-client"
  },
  "homepage": "https://github.com/pumpkinredbean/app-agent-interface#readme",
  "bugs": {
    "url": "https://github.com/pumpkinredbean/app-agent-interface/issues"
  },
  "keywords": [
    "ai-agent",
    "android",
    "tool-calling"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -b",
    "prepack": "npm run build",
    "test": "npm run build && node --test dist/test/**/*.test.js",
    "typecheck": "tsc -b --pretty false"
  },
  "devDependencies": {
    "ajv": "8.20.0"
  }
}
