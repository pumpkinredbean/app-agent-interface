{
  "name": "app-agent-interface",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/app-agent-client",
    "packages/app-agent-android-ui",
    "examples/weather-agent/desktop"
  ],
  "scripts": {
    "build": "tsc -b",
    "clean": "tsc -b --clean",
    "docs:check": "node scripts/check-docs.mjs",
    "lint": "eslint scripts packages/app-agent-client/src packages/app-agent-client/test packages/app-agent-android-ui/src packages/app-agent-android-ui/test examples/weather-agent/desktop/src examples/weather-agent/desktop/test examples/weather-agent/desktop/scripts",
    "test": "npm run build && node --test packages/app-agent-client/dist/test/**/*.test.js packages/app-agent-android-ui/dist/test/**/*.test.js examples/weather-agent/desktop/dist/test/**/*.test.js",
    "typecheck": "tsc -b --pretty false",
    "pack:check": "npm pack --dry-run --workspace=@pumpkinredbean/app-agent-client && npm pack --dry-run --workspace=@pumpkinredbean/app-agent-android-ui"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.1",
    "eslint": "10.9.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.68.0"
  }
}
