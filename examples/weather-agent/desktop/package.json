{
  "name": "app-agent-interface-weather-agent-example",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -b",
    "demo": "npm run build --silent && node dist/src/cli/demo.js",
    "ui": "npm run build --silent && node dist/src/server/server.js",
    "ui:driver": "npm run build --silent && node dist/scripts/android-ui-driver.js",
    "ui:driver:build": "npm run build --silent && node dist/scripts/android-ui-driver.js build",
    "ui:driver:install": "npm run build --silent && node dist/scripts/android-ui-driver.js install",
    "ui:driver:status": "npm run build --silent && node dist/scripts/android-ui-driver.js status",
    "ui:driver:stop": "npm run build --silent && node dist/scripts/android-ui-driver.js stop",
    "models:codex": "npm run build --silent && node dist/src/cli/list-codex-models.js",
    "test": "npm run build && node --test dist/test/**/*.test.js",
    "typecheck": "tsc -b --pretty false"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@pumpkinredbean/app-agent-android-ui": "0.1.0",
    "@pumpkinredbean/app-agent-client": "0.1.0",
    "@anthropic-ai/claude-agent-sdk": "0.3.251",
    "ai": "6.0.272",
    "ai-sdk-provider-codex-cli": "1.3.1",
    "ai-sdk-provider-github": "1.0.0",
    "ajv": "8.20.0",
    "zod": "4.3.6"
  },
  "overrides": {
    "ai-sdk-provider-github": {
      "@github/copilot-sdk": "0.3.0"
    }
  }
}
